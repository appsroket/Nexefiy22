# Nexefiy environment variables — template only.
# Copy to .env.local and fill in values. Never commit real secrets.
# Full reference: docs/environment-variables.md

# --- Supabase (public: safe for browser code) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (server only: never prefix with NEXT_PUBLIC_) ---
# Required from Phase 2 for privileged server/worker operations.
SUPABASE_SECRET_KEY=
# Used only by the Supabase CLI for migrations; not read by the app.
SUPABASE_DB_PASSWORD=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI model providers (server only, Phase 4) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Durable execution (server only, Phase 7) ---
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- Integration credential encryption (server only, Phase 6) ---
# 32-byte base64 key for envelope encryption of OAuth tokens outside Vault.
INTEGRATION_ENCRYPTION_KEY=

# --- Integrations (server only, Phase 6) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Billing (Phase 10) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability (optional) ---
SENTRY_DSN=
